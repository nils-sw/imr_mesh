#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require

layout(scalar, buffer_reference) buffer VertexBuffer {
	vec4 vertices[];
};

layout(scalar, buffer_reference) buffer FaceBuffer {
	uvec4 faces[];
};

layout(scalar, buffer_reference) buffer PositionBuffer {
	vec3 positions[];
};

layout(scalar, push_constant) uniform T {
	VertexBuffer vertex_buffer;
    mat4 matrix;
	FaceBuffer face_buffer;
	PositionBuffer position_buffer;
} push_constants;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 8, max_primitives = 12) out;

// layout(location = 0) out VertexOutput
// {
// 	vec4 color;
// } vertexOutput[];

const vec4[6] colors = {
	vec4(0.0, 1.0, 0.0, 1.0),	// top
	vec4(1.0, 0.0, 0.0, 1.0),	// north
	vec4(0.0, 0.0, 1.0, 1.0),	// west
	vec4(1.0, 0.0, 1.0, 1.0), 	// east
	vec4(0.0, 1.0, 1.0, 1.0), 	// south
	vec4(1.0, 1.0, 0.0, 1.0) 	// bottom
	};

layout(location = 1) out PrimitiveOutput {
	vec4 color;
} primitiveOutput[];

void main()
{
	uint iid = gl_LocalInvocationID.x;
	uint gid = gl_GlobalInvocationID.x;

	vec4 starting_pos = vec4(push_constants.position_buffer.positions[gid], 1.0);
	uvec4 index = push_constants.face_buffer.faces[gid];

	SetMeshOutputsEXT(0, 2);
	mat4 mvp = push_constants.matrix;
	gl_MeshVerticesEXT[0].gl_Position = mvp * (push_constants.vertex_buffer.vertices[index[0]]);
	gl_MeshVerticesEXT[1].gl_Position = mvp * (push_constants.vertex_buffer.vertices[index[1]]);
	gl_MeshVerticesEXT[2].gl_Position = mvp * (push_constants.vertex_buffer.vertices[index[2]]);
	gl_MeshVerticesEXT[3].gl_Position = mvp * (push_constants.vertex_buffer.vertices[index[3]]);
	// vertexOutput[0].color = colors[gid];
	// vertexOutput[1].color = colors[gid];
	// vertexOutput[2].color = colors[gid];
	// vertexOutput[3].color = colors[gid];
	primitiveOutput[0].color = colors[gid];
	primitiveOutput[1].color = colors[gid];
	gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 3);
	gl_PrimitiveTriangleIndicesEXT[1] = uvec3(1, 2, 3);
}
