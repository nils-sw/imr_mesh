#version 450
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require

layout(scalar, buffer_reference) buffer VertexBuffer {
	vec4 vertices[];
};

layout(scalar, buffer_reference) buffer FaceBuffer {
	uvec4 faces[];
};

layout(scalar, buffer_reference) buffer PositionBuffer {
	vec3 positions[];
};

layout(scalar, push_constant) uniform T {
	VertexBuffer vertex_buffer;
    mat4 matrix;
	FaceBuffer face_buffer;
	PositionBuffer position_buffer;
	// int num_instances;
	// int first_instance;
} push_constants;

layout(local_size_x = 12, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 24, max_primitives = 12) out;

// layout(location = 0) out VertexOutput
// {
// 	vec4 color;
// } vertexOutput[];

const vec4[6] colors = {
	vec4(0.0, 1.0, 0.0, 1.0),	// top
	vec4(1.0, 0.0, 0.0, 1.0),	// north
	vec4(0.0, 0.0, 1.0, 1.0),	// west
	vec4(1.0, 0.0, 1.0, 1.0), 	// east
	vec4(0.0, 1.0, 1.0, 1.0), 	// south
	vec4(1.0, 1.0, 0.0, 1.0) 	// bottom
	};

layout(location = 1) perprimitiveEXT out PrimitiveOutput {
	vec4 color;
} primitiveOutput[];

struct Task {
	uint offset;
	uint numWorkgroups;
};

taskPayloadSharedEXT Task payload;

void main() {
	SetMeshOutputsEXT(4 * 6, 2 * 6);

	uint sharedData = payload.offset * gl_NumWorkGroups.x;

    bool is_even = gl_LocalInvocationID.x % 2 == 0;
	uint triId = gl_LocalInvocationID.x;
	uint faceId = triId / 2;

	uint instance_id = gl_WorkGroupID.x;

    vec3 offset = push_constants.position_buffer.positions[sharedData + instance_id];
	uvec4 index = push_constants.face_buffer.faces[faceId];

	mat4 mvp = push_constants.matrix;

	if (is_even) {
        gl_MeshVerticesEXT[faceId * 4 + 0].gl_Position = mvp * vec4(push_constants.vertex_buffer.vertices[index[0]].xyz + offset, 1);
        gl_MeshVerticesEXT[faceId * 4 + 1].gl_Position = mvp * vec4(push_constants.vertex_buffer.vertices[index[1]].xyz + offset, 1);
	} else {
        gl_MeshVerticesEXT[faceId * 4 + 2].gl_Position = mvp * vec4(push_constants.vertex_buffer.vertices[index[2]].xyz + offset, 1);
        gl_MeshVerticesEXT[faceId * 4 + 3].gl_Position = mvp * vec4(push_constants.vertex_buffer.vertices[index[3]].xyz + offset, 1);
	}
	if (is_even) {
    	gl_PrimitiveTriangleIndicesEXT[triId] = uvec3(faceId * 4 + 0, faceId * 4 + 1, faceId * 4 + 3);
	    primitiveOutput[triId].color = colors[faceId];
    } else {
    	gl_PrimitiveTriangleIndicesEXT[triId] = uvec3(faceId * 4 + 1, faceId * 4 + 2, faceId * 4 + 3);
	    primitiveOutput[triId].color = colors[faceId];
    }
}
